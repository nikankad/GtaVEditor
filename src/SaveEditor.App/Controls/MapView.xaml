<UserControl x:Class="SaveEditor.App.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SaveEditor.App">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GtaVSaveEditor;component/Themes/GtaMap.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MapButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!-- Scroll to zoom at the pointer, drag to pan. -->
        <Grid x:Name="MapViewport" ClipToBounds="True" Background="Transparent" Cursor="SizeAll"
              MouseWheel="Map_MouseWheel" MouseLeftButtonDown="Map_MouseDown" MouseMove="Map_MouseMove"
              MouseLeftButtonUp="Map_MouseUp" LostMouseCapture="Map_LostCapture">
            <!-- Fills the viewport, so zoom and pan are in viewport pixels. -->
            <Grid x:Name="ZoomLayer">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MapZoom"/>
                        <TranslateTransform x:Name="MapPan"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Viewbox Stretch="Uniform">
                    <Grid x:Name="MapArea">
                        <Image Source="{StaticResource GtaMapImage}" Stretch="Fill" IsHitTestVisible="False"/>
                        <ItemsControl x:Name="MapLabels" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Width="80" TextAlignment="Center" FontSize="10" Foreground="#4A525C"
                                               RenderTransformOrigin="0.5,0.5">
                                        <!-- Undoes most of the zoom, so names stay about the same size on screen. -->
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding MarkerScale, RelativeSource={RelativeSource AncestorType=local:MapView}}" ScaleY="{Binding MarkerScale, RelativeSource={RelativeSource AncestorType=local:MapView}}"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- The host's markers: items with MapLeft/MapTop (map pixels), drawn with its MarkerTemplate. -->
                        <ItemsControl ItemsSource="{Binding Markers, RelativeSource={RelativeSource AncestorType=local:MapView}}" ItemTemplate="{Binding MarkerTemplate, RelativeSource={RelativeSource AncestorType=local:MapView}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding MapLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding MapTop}"/>
                                    <Setter Property="Panel.ZIndex" Value="{Binding MapLayer}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </Grid>
                </Viewbox>
            </Grid>
        </Grid>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
            <Button Content="+" Style="{StaticResource MapButton}" Click="ZoomIn_Click" ToolTip="Zoom in"/>
            <Button Content="−" Style="{StaticResource MapButton}" Click="ZoomOut_Click" ToolTip="Zoom out"/>
            <Button Content="⤢" Style="{StaticResource MapButton}" Click="ZoomReset_Click" ToolTip="Show the whole map"/>
        </StackPanel>
    </Grid>
</UserControl>
