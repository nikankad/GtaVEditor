<UserControl x:Class="SaveEditor.App.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{StaticResource PageBrush}">
        <!-- Header: which save, and the file actions. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,12"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,3">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="← Back" Style="{StaticResource HeaderButton}" Click="Back_Click"
                        VerticalAlignment="Center" Margin="0,0,18,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="About" Style="{StaticResource HeaderButton}" Click="About_Click"
                            ToolTip="What this app is and who made it"/>
                    <Button Content="Save to game slot…" Style="{StaticResource HeaderButton}" Margin="8,0,0,0" Click="SaveToSlot_Click"
                            ToolTip="Write this save into one of the game's Load Game slots"/>
                    <Button Content="Save as…" Style="{StaticResource HeaderButton}" Margin="8,0,0,0" Click="SaveAs_Click"/>
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            IsEnabled="False" Click="Save_Click" ToolTip="Overwrite the file you opened (a backup is made first)"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Foreground="White" FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleText" Foreground="#B8C2CC" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Sections" TabStripPlacement="Left" BorderThickness="0" Padding="0" Background="{StaticResource PageBrush}"
                    ItemContainerStyle="{StaticResource NavTab}">
            <!-- Checklist -->
            <TabItem Header="Checklist">
                <DockPanel Margin="28,22,28,12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Checklist" Style="{StaticResource PageTitle}" FontSize="20"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,14"
                                   Text="The game's 100% completion checklist. Click an item to mark it done or not done; the completion percentage updates to match."/>
                        <TextBlock x:Name="ChecklistError" Style="{StaticResource ErrorText}" FontSize="13" Text=""/>
                        <Border x:Name="ChecklistSummary" Style="{StaticResource Card}" Margin="0,0,0,14" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,28,0" MinWidth="120">
                                    <TextBlock x:Name="CompletionText" FontFamily="{StaticResource HeadingFont}" FontSize="40" FontWeight="Bold"
                                               Foreground="{StaticResource MoneyBrush}"/>
                                    <TextBlock Text="Game completion" Style="{StaticResource Muted}"/>
                                </StackPanel>
                                <ItemsControl x:Name="ChecklistRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                                <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                                             VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Percent}" Style="{StaticResource Muted}" TextAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="ChecklistPicker" Orientation="Horizontal" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Content="Mark this section done" Click="ChecklistAllDone_Click" Margin="0,0,6,6"/>
                            <Button Content="Mark this section not done" Click="ChecklistNoneDone_Click" Margin="0,0,6,6"/>
                            <Button Content="Complete everything for 100%" Click="Checklist100_Click" Margin="0,0,6,6"
                                    ToolTip="Marks every item that counts toward 100% as done"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Ticking an item here changes the checklist and completion figures only. To move the story on, use Missions."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChecklistItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Width="265" Padding="12,9" Margin="0,0,10,10" ToolTip="{Binding Label}">
                                        <CheckBox IsChecked="{Binding Done}" VerticalContentAlignment="Top">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="11"
                                                           Visibility="{Binding NoteVisibility}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Missions -->
            <TabItem Header="Missions">
                <DockPanel Margin="28,22,28,12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Missions" Style="{StaticResource PageTitle}" FontSize="20"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,14" TextWrapping="Wrap"
                                   Text="Progress through the story. Tick a mission to mark it completed; when you load the save, the game skips every completed mission it reaches and carries on with the story."/>
                        <TextBlock x:Name="MissionsError" Style="{StaticResource ErrorText}" FontSize="13" Text=""/>
                        <WrapPanel>
                        <Border x:Name="MissionsSummary" Style="{StaticResource Card}" Margin="0,0,14,14" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,28,0" MinWidth="220">
                                    <TextBlock Text="Next mission" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="NextMissionText" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MissionCountText" Style="{StaticResource Muted}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <Button x:Name="CompleteNextButton" Content="Complete next mission" Style="{StaticResource PrimaryButton}"
                                            Click="CompleteNextMission_Click" Margin="0,0,0,6"/>
                                    <Button Content="Complete the whole story" Click="CompleteStory_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="CrewCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,28,0" MinWidth="180">
                                    <TextBlock Text="Heist crew" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="CrewText" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CrewDeadText" Style="{StaticResource Muted}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <Button x:Name="UnlockCrewButton" Content="Unlock every crew member" Click="UnlockCrew_Click" Margin="0,0,0,6"
                                            ToolTip="Gunmen, drivers and hackers you'd normally meet as Strangers and Freaks or random events"/>
                                    <Button x:Name="ReviveCrewButton" Content="Bring dead crew back" Click="ReviveCrew_Click"
                                            ToolTip="Crew members who died during a heist can be hired again"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </WrapPanel>
                        <TextBlock Text="Heist approaches and ending" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <WrapPanel x:Name="ChoicePickers" Margin="0,0,0,10"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Skipped missions don't pay out what the mission itself would (heist takes, for example). The game still asks for heist plans on the planning board; pick the approach you chose here. Unticking a mission the story has already passed doesn't make you replay it."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MissionItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Style="{StaticResource Card}" Padding="12,7" Margin="0,0,0,6" MaxWidth="720"
                                            HorizontalAlignment="Left" ToolTip="{Binding Code}">
                                        <DockPanel Width="690">
                                            <Button DockPanel.Dock="Right" Content="Complete up to here" Style="{StaticResource LinkButton}"
                                                    VerticalAlignment="Center" Click="CompleteUpTo_Click"
                                                    ToolTip="Mark this mission and every mission before it completed"/>
                                            <TextBlock x:Name="NextTag" DockPanel.Dock="Right" Text="NEXT" FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,14,0"
                                                       Visibility="Collapsed"/>
                                            <CheckBox IsChecked="{Binding Done}" VerticalContentAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" Margin="10,0,0,0"
                                                               VerticalAlignment="Center" Visibility="{Binding NoteVisibility}"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsNext}" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="NextTag" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Strangers and Freaks -->
            <TabItem Header="Strangers &amp; Freaks">
                <DockPanel Margin="28,22,28,12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Strangers &amp; Freaks" Style="{StaticResource PageTitle}" FontSize="20"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,14" TextWrapping="Wrap"
                                   Text="Tick a mission to mark it completed; its checklist entry is ticked too. The stranger won't offer it again."/>
                        <TextBlock x:Name="StrangersError" Style="{StaticResource ErrorText}" FontSize="13" Text=""/>
                        <WrapPanel x:Name="StrangersButtons">
                            <TextBlock x:Name="StrangersCountText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,6"/>
                            <Button Content="Complete all" Click="StrangersAll_Click" Margin="0,0,6,6"/>
                            <Button Content="Mark all not done" Click="StrangersNone_Click" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl x:Name="StrangerGroups">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Width="300" Margin="0,0,12,12" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Character}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Missions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Done}" Margin="0,3" ToolTip="{Binding Script}">
                                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="CollectiblesTab" Header="Collectibles"/>

            <!-- Player -->
            <TabItem Header="Player">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Max all skills for everyone" Click="MaxEveryonesSkills_Click"/>
                            <TextBlock Text="Player" Style="{StaticResource PageTitle}" FontSize="20"/>
                        </DockPanel>
                        <TextBlock Text="Money and skills for Michael, Franklin and Trevor." Style="{StaticResource Muted}" Margin="0,2,0,16"/>
                        <TextBlock x:Name="CharactersError" Style="{StaticResource ErrorText}" FontSize="13" Text=""/>
                        <ItemsControl x:Name="CharacterList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Max skills" Style="{StaticResource LinkButton}"
                                                        VerticalAlignment="Center" Click="MaxSkills_Click"/>
                                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <TextBlock Text="Cash" Style="{StaticResource Muted}" Margin="0,14,0,3"/>
                                            <TextBox Text="{Binding Cash, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                                     IsEnabled="{Binding HasCash}" FontSize="15" Padding="4,3"/>
                                            <TextBlock Text="{Binding CashError}" Style="{StaticResource ErrorText}" Margin="0,2,0,0"/>
                                            <TextBlock Text="Skills" Style="{StaticResource Muted}" Margin="0,16,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Skills}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="92"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="42"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                                                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                                                    Value="{Binding Value}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0}%}"
                                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Status: health, armor, special ability, wanted level, location -->
                        <DockPanel Margin="0,14,0,0">
                            <Button DockPanel.Dock="Right" Content="Full health, armor and ability for everyone" Click="MaxStatus_Click"/>
                            <TextBlock Text="Status" Style="{StaticResource SectionTitle}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,10" TextWrapping="Wrap"
                                   Text="Health, armor, special ability and wanted level as each character had them, and where each one is when you switch to them."/>
                        <TextBlock x:Name="StatusError" Style="{StaticResource ErrorText}" FontSize="13" Text=""/>
                        <ItemsControl x:Name="StatusList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CurrentNote}" Style="{StaticResource Muted}" FontSize="11"
                                                       Visibility="{Binding CurrentVisibility}"/>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Health" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                                        Value="{Binding Health}" Margin="0,4"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Health, StringFormat={}{0}%}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="1" Text="Armor" VerticalAlignment="Center"/>
                                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                                        Value="{Binding Armor}" Margin="0,4"/>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Armor, StringFormat={}{0}%}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Content="Special ability unlocked" IsChecked="{Binding AbilityUnlocked}" Margin="0,6,0,2"/>
                                                <TextBlock Grid.Row="3" Text="Ability bar" VerticalAlignment="Center"/>
                                                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                                        Value="{Binding Ability}" IsEnabled="{Binding AbilityUnlocked}" Margin="0,4"/>
                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Ability, StringFormat={}{0}%}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="4" Text="Wanted level" VerticalAlignment="Center"/>
                                                <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1"
                                                        TickPlacement="BottomRight" Value="{Binding Wanted}" Margin="0,4"/>
                                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding WantedText}" TextAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="#C8960C"/>
                                            </Grid>
                                            <TextBlock Text="Location (pick a place, or type coordinates)" Style="{StaticResource Muted}" Margin="0,12,0,3"/>
                                            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" Margin="0,0,0,6"
                                                      ToolTip="Move this character to a well-known place"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="X" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox Width="70" Text="{Binding X, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"/>
                                                <TextBlock Text="Y" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                <TextBox Width="70" Text="{Binding Y, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"/>
                                                <TextBlock Text="Z" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                <TextBox Width="60" Text="{Binding Z, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Game clock -->
                        <TextBlock Text="Game date and time" Style="{StaticResource SectionTitle}" Margin="0,14,0,8"/>
                        <Border x:Name="ClockCard" Style="{StaticResource Card}" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Time" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Width="60" Text="{Binding Time, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                         ToolTip="24-hour clock, e.g. 13:30"/>
                                <TextBlock Text="Date" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,6,0"/>
                                <DatePicker SelectedDate="{Binding Date}" Width="140"/>
                                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Vehicles -->
            <TabItem Header="Vehicles">
                <DockPanel Margin="28,22,28,12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Vehicles" Style="{StaticResource PageTitle}" FontSize="20"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,14" TextWrapping="Wrap"
                                   Text="Give yourself cars, motorcycles, planes, helicopters and boats, and buy businesses. Vehicles are waiting where you put them, undamaged, when you load the save."/>
                        <TextBlock x:Name="GaragesError" Style="{StaticResource ErrorText}" FontSize="13" Text=""/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="A vehicle you give replaces whatever was in that space. Michael and Franklin only see hangar, helipad and dock vehicles once they own that hangar, helipad or dock."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                        <TextBlock Text="Safehouse garages" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="GarageList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Owner}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Slots}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,6,0,6">
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Content="Empty" Style="{StaticResource LinkButton}"
                                                                        Click="EmptySpace_Click" IsEnabled="{Binding CanEmpty}"/>
                                                                <TextBlock>
                                                                    <Run Text="{Binding Space, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                                                    <Run Text="  "/>
                                                                    <Run Text="{Binding VehicleName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                </TextBlock>
                                                            </DockPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding CanPlace}">
                                                                <ComboBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding Vehicle}" Width="210"
                                                                          ToolTip="Vehicle to park here"/>
                                                                <ComboBox ItemsSource="{Binding Colours}" SelectedItem="{Binding Colour}" Width="110" Margin="6,0"
                                                                          ToolTip="Paint colour"/>
                                                                <Button Content="Park here" Click="ParkHere_Click"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Planes, helicopters and boats" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/>
                        <TextBlock x:Name="PropertyVehiclesError" Style="{StaticResource ErrorText}" FontSize="13" Text=""/>
                        <ItemsControl x:Name="PropertyVehicleList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/>
                                            <ItemsControl ItemsSource="{Binding Slots}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,8,0,4">
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Content="Empty" Style="{StaticResource LinkButton}"
                                                                        Click="EmptyPropertyVehicle_Click" IsEnabled="{Binding CanEmpty}"/>
                                                                <TextBlock>
                                                                    <Run Text="{Binding Owner, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                                                    <Run Text="  "/>
                                                                    <Run Text="{Binding VehicleName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                </TextBlock>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Place}" Style="{StaticResource Muted}" FontSize="11"/>
                                                            <Grid Margin="0,4,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="76"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ComboBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding Vehicle}"/>
                                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Colours}" SelectedItem="{Binding Colour}" Margin="4,0"/>
                                                                <Button Grid.Column="2" Content="Give" Click="GivePropertyVehicle_Click"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,10,0,8">
                            <Button DockPanel.Dock="Right" Content="Give every business to its usual owner" Click="BuyAllProperties_Click"
                                    ToolTip="Each business goes to a character who can buy it in the game"/>
                            <TextBlock Text="Businesses" Style="{StaticResource SectionTitle}"/>
                        </DockPanel>
                        <TextBlock x:Name="PropertiesError" Style="{StaticResource ErrorText}" FontSize="13" Text=""/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <ItemsControl x:Name="PropertyList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4,18,4">
                                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding OwnerChoices}" SelectedItem="{Binding Owner}" Width="100"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Kind}" Style="{StaticResource Muted}" FontSize="11"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Stats -->
            <TabItem Header="Stats">
                <DockPanel Margin="28,22,28,12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Stats" Style="{StaticResource PageTitle}" FontSize="20"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,12" TextWrapping="Wrap"
                                   Text="Every stat the game keeps in this save: money, combat, vehicles, shooting range scores, mission objectives, stock market and more. Type a new value and press Tab to apply it."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Search" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="StatSearch" Width="240" TextChanged="StatFilter_Changed"
                                     ToolTip="Search every category by name, e.g. tattoo, headshot or golf"/>
                            <TextBlock Text="Character" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,6,0"/>
                            <ComboBox x:Name="StatCharacter" Width="130" SelectionChanged="StatFilter_Changed"/>
                            <TextBlock x:Name="StatCount" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="StatsError" Style="{StaticResource ErrorText}" FontSize="13" Text=""/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Most stats are records the game shows in its Stats menu; changing them doesn't unlock anything by itself. Grey values are kept in step by another tab."/>
                    <ListBox x:Name="StatCategories" DockPanel.Dock="Left" Width="190" Margin="0,0,14,0"
                             SelectionChanged="StatFilter_Changed" Style="{StaticResource DarkList}"
                             ItemContainerStyle="{StaticResource DarkListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Muted}" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox x:Name="StatRows" HorizontalContentAlignment="Stretch" Style="{StaticResource DarkList}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DarkListItem}">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Character}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                                 IsReadOnly="{Binding IsReadOnly}" ToolTip="{Binding ReadOnlyNote}"
                                                 Visibility="{Binding TextVisibility}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <CheckBox IsChecked="{Binding BoolValue}" Content="Yes" Visibility="{Binding BoolVisibility}"/>
                                        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Weapons -->
            <TabItem Header="Weapons">
                <DockPanel Margin="28,22,28,12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Weapons" Style="{StaticResource PageTitle}" FontSize="20"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,14"
                                   Text="Tick a weapon to give it, untick to take it away. Weapons you give come with full ammo."/>
                        <StackPanel x:Name="CharacterPicker" Orientation="Horizontal" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Content="Give all weapons" Click="GiveAll_Click" Margin="0,0,6,6"/>
                            <Button Content="Fill all ammo" Click="FillAmmo_Click" Margin="0,0,6,6"/>
                            <Button Content="Remove all weapons" Click="RemoveAll_Click" Margin="0,0,6,6"/>
                            <CheckBox x:Name="AllCharactersBox" Content="Apply these buttons to all three characters"
                                      VerticalAlignment="Center" Margin="10,0,0,6"/>
                        </WrapPanel>
                        <TextBlock x:Name="WeaponsError" Style="{StaticResource ErrorText}" FontSize="13" Text=""/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"
                               Text="Weapons sit in fixed slots in the save; a weapon you remove is simply an empty slot, as in a save where it was never picked up."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="WeaponGroups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,0,4">
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Weapons}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Card}" Width="235" Padding="12,9" Margin="0,0,10,10">
                                                        <StackPanel>
                                                            <CheckBox IsChecked="{Binding Owned}" FontWeight="SemiBold">
                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                            </CheckBox>
                                                            <StackPanel Orientation="Horizontal" Margin="20,7,0,0" Visibility="{Binding AmmoVisibility}"
                                                                        IsEnabled="{Binding Owned}">
                                                                <TextBlock Text="Ammo" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <TextBox Width="62" Padding="2,1"
                                                                         Text="{Binding Ammo, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"/>
                                                                <TextBlock Text="{Binding MaxText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0"/>
                                                                <Button Content="Max" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                                                        Click="WeaponMax_Click"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding AmmoError}" Style="{StaticResource ErrorText}" Margin="20,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="UnlocksTab" Header="Unlocks"/>
            <TabItem x:Name="FlagsTab" Header="Game flags"/>
        </TabControl>
    </DockPanel>
</UserControl>
