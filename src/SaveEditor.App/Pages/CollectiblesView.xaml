<UserControl x:Class="SaveEditor.App.CollectiblesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/GtaTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Margin="28,22,28,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Collectibles" Style="{StaticResource PageTitle}" FontSize="20"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,14" TextWrapping="Wrap"
                       Text="Tick an item, or click its dot on the map, to mark it found. Each kind's counter and checklist entry update to match."/>
            <TextBlock x:Name="Error" Style="{StaticResource ErrorText}" FontSize="13" Text=""/>
            <WrapPanel x:Name="KindPicker" Margin="0,0,0,12"/>
            <WrapPanel x:Name="Actions">
                <TextBlock x:Name="CountText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,6"/>
                <Button Content="Mark all found" Click="All_Click" Margin="0,0,6,6"/>
                <Button Content="Mark all not found" Click="None_Click" Margin="0,0,6,6"/>
                <Button Content="Every kind: all found" Click="Everything_Click" Margin="0,0,6,6"
                        ToolTip="Marks every item of every kind found"/>
                <StackPanel x:Name="CountPanel" Orientation="Horizontal" Margin="12,0,0,6">
                    <TextBlock Text="Completed" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="CountBox" Width="50" VerticalContentAlignment="Center"/>
                    <Button Content="Set" Click="SetCount_Click" Margin="6,0,0,0"/>
                    <TextBlock x:Name="CountError" Style="{StaticResource ErrorText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </WrapPanel>
        </StackPanel>
        <TextBlock x:Name="Note" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="MapBorder" Background="#14181C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    VerticalAlignment="Top" Margin="0,0,16,0" ToolTip="Positions only; north is up">
                <Viewbox x:Name="MapBox" Stretch="Uniform" StretchDirection="DownOnly">
                    <Grid x:Name="MapArea">
                        <ItemsControl x:Name="MapLabels" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Width="80" TextAlignment="Center" FontSize="10" Foreground="#4A525C"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="MapDots">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding MapLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding MapTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse x:Name="Dot" Width="10" Height="10" Stroke="Black" StrokeThickness="1" Cursor="Hand"
                                             Fill="{StaticResource AccentBrush}" ToolTip="{Binding Tip}" MouseLeftButtonUp="Dot_Click"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Collected}" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource MoneyBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Viewbox>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="Legend" Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource MoneyBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Found" Style="{StaticResource Muted}" Margin="5,0,16,0"/>
                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Not found" Style="{StaticResource Muted}" Margin="5,0,0,0"/>
                    </StackPanel>
                    <ItemsControl x:Name="ItemList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="96" Padding="10,7" Margin="0,0,8,8" ToolTip="{Binding Tip}">
                                    <CheckBox IsChecked="{Binding Collected}" Content="{Binding Label}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
