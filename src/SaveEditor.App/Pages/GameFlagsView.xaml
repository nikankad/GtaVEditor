<UserControl x:Class="SaveEditor.App.GameFlagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SaveEditor.App">
    <DockPanel Margin="28,22,28,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Game flags" Style="{StaticResource PageTitle}" FontSize="20"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,12" TextWrapping="Wrap"
                       Text="Switches the story sets as it moves on: things unlocked, collectibles finished, texts already sent. Hover a flag for the game's own name."/>
            <TextBlock x:Name="Error" Style="{StaticResource ErrorText}" FontSize="13" Text=""/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Search" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="Search" Width="240" TextChanged="Search_Changed" ToolTip="e.g. unlock, bike, letter"/>
                <TextBlock x:Name="CountText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="The missions read and set these flags themselves. Turning one on early can skip or confuse part of the story; keep the backup."/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Groups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Key}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><local:MasonryPanel ColumnWidth="280" Spacing="10"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="12,9" ToolTip="{Binding Id}">
                                            <CheckBox IsChecked="{Binding On}">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
