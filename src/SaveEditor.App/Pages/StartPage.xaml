<UserControl x:Class="SaveEditor.App.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{StaticResource PageBrush}">
        <!-- Header, as on the editor page. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,12"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,3">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="About" Style="{StaticResource HeaderButton}" Click="About_Click"
                        VerticalAlignment="Center" ToolTip="What this app is and who made it"/>
                <TextBlock Text="GTA V Save Editor" Foreground="White" FontFamily="{StaticResource HeadingFont}" FontSize="24"
                           FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,28" MaxWidth="720" HorizontalAlignment="Center">
                <Image Height="170" HorizontalAlignment="Center" Margin="0,0,0,20" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Source>
                        <BitmapImage UriSource="/Assets/logo.png" DecodePixelHeight="340"/>
                    </Image.Source>
                </Image>
                <TextBlock Text="Edit a story mode save" Style="{StaticResource PageTitle}" HorizontalAlignment="Center"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,6,0,22" TextAlignment="Center"
                           Text="Pick a GTA V PC save file to change missions, collectibles, money, vehicles, weapons and more. Nothing is written until you press Save in the editor."/>

                <!-- Key missing -->
                <Border x:Name="KeyBanner" Style="{StaticResource Card}" BorderBrush="{StaticResource AccentBrush}" Margin="0,0,0,18"
                        Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Import key…" Style="{StaticResource PrimaryButton}" Click="ImportKey_Click"
                                VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="Encryption key needed" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                       Text="GTA V encrypts PC saves with a key that isn't included with this app. Import it once and you can open your saves."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Button x:Name="SelectButton" Content="Select a save file…" Style="{StaticResource PrimaryButton}" FontSize="20"
                        Padding="28,12" HorizontalAlignment="Center" Click="Select_Click"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"
                           Text="Saves are in Documents\Rockstar Games\GTA V\Profiles\…, named SGTA50000 to SGTA50015."/>
                <WrapPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Button Content="Open backups folder" Click="Backups_Click" Margin="0,0,0,8"
                            ToolTip="The copies made before every save"/>
                </WrapPanel>

                <!-- Disclaimer -->
                <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="Back up your saves first" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                                   Text="Editing a save can corrupt it, stop it loading, or break story progress, and you could lose the save for good. The editor copies the old file to the backups folder before every write, but keep your own copy of any save you care about as well."/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" LineHeight="20"
                                   Text="Story mode only. Not made by or affiliated with Rockstar Games. Edits haven't been tested in-game for every case; use at your own risk. With cloud saves on, the game may replace an edited save with the cloud copy."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
