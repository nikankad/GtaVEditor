<Window x:Class="SaveEditor.App.ReviewChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review changes" Height="700" Width="860" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource PageBrush}" Icon="/Assets/app.ico">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" FontSize="22"/>
            <TextBlock x:Name="Intro" Style="{StaticResource Muted}" Margin="0,4,0,0" LineHeight="18"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="UndoAllButton" DockPanel.Dock="Left" Content="Undo everything I can" Click="UndoAll_Click"
                    ToolTip="Puts back every change that has an Undo button"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Confirm_Click"/>
                <Button x:Name="CloseButton" Content="Keep editing" Margin="6,0,0,0" IsCancel="True"/>
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="Empty" Text="Nothing has changed since the save was opened or last saved." Style="{StaticResource Muted}"
                   FontSize="14" Visibility="Collapsed"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Sections">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="{Binding Expanded, Mode=OneTime}" Margin="0,0,0,10" Foreground="{StaticResource TextBrush}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" FontSize="16"/>
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="{Binding Note}" FontSize="11" Margin="0,0,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Note}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Changes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Margin="0,0,12,0"/>
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320">
                                                        <Run Text="{Binding Before, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                                        <Run Text="  →  " Foreground="{StaticResource AccentBrush}"/>
                                                        <Run Text="{Binding After, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <Button Grid.Column="2" Content="Undo" HorizontalAlignment="Right" Click="Undo_Click"
                                                            IsEnabled="{Binding CanUndo}" Padding="12,3">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanUndo}" Value="False">
                                                                        <Setter Property="ToolTip" Value="This one can't be put back here; change it back on its tab."/>
                                                                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
