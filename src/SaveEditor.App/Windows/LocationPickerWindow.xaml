<Window x:Class="SaveEditor.App.LocationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SaveEditor.App"
        Title="Choose a location" Height="780" Width="1120" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource PageBrush}" Icon="/GtaVSaveEditor;component/Assets/app.ico">
    <Window.Resources>
        <!-- Small dots are places you can stand; bigger yellow dots are named places; portraits are where each character is now. -->
        <DataTemplate x:Key="SpotTemplate">
            <Grid Width="{Binding Size}" Height="{Binding Size}" Cursor="Hand" Background="Transparent" ToolTip="{Binding Name}"
                  MouseLeftButtonUp="Spot_Click" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="{Binding MarkerScale, RelativeSource={RelativeSource AncestorType=local:MapView}}"
                                    ScaleY="{Binding MarkerScale, RelativeSource={RelativeSource AncestorType=local:MapView}}"/>
                </Grid.RenderTransform>
                <Ellipse x:Name="Ring" Margin="-6" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5" Fill="#66000000"
                         Visibility="Collapsed"/>
                <Ellipse x:Name="Dot" Fill="#C8CDD3" Stroke="#14181C" StrokeThickness="1"/>
                <Ellipse x:Name="Face" Stroke="{Binding Colour}" StrokeThickness="2" Visibility="Collapsed">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Place">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Dot" Property="Stroke" Value="Black"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Character">
                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Face" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <Border Background="#14181C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,16,0">
            <Grid>
                <local:MapView x:Name="Map" MapClick="Map_Click" MarkerTemplate="{StaticResource SpotTemplate}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" IsHitTestVisible="False">
                    <Ellipse Width="11" Height="11" Fill="{StaticResource AccentBrush}" Stroke="Black" VerticalAlignment="Center"/>
                    <TextBlock Text="Named place" Style="{StaticResource Muted}" Margin="5,0,14,0" VerticalAlignment="Center"/>
                    <Ellipse Width="7" Height="7" Fill="#C8CDD3" VerticalAlignment="Center"/>
                    <TextBlock Text="Spot you can stand on" Style="{StaticResource Muted}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" FontSize="20" TextWrapping="Wrap"/>
                <TextBlock x:Name="Intro" Style="{StaticResource Muted}" Margin="0,4,0,12" LineHeight="18"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <!-- The chosen spot -->
                <Border x:Name="ChosenCard" Style="{StaticResource Card}" BorderBrush="{StaticResource AccentBrush}" Margin="0,12,0,12">
                    <StackPanel>
                        <TextBlock Text="Chosen spot" Style="{StaticResource Muted}" FontSize="11"/>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Area}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Coordinates}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                        <TextBlock x:Name="SnapNote" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click"/>
                    <Button Content="Cancel" Width="90" Margin="6,0,0,0" IsCancel="True"/>
                </StackPanel>
            </StackPanel>

            <!-- Named places, for a quick pick -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Places" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,0,0,6"/>
                <ListBox x:Name="PlaceList" SelectionChanged="PlaceList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="20" Height="20" Margin="0,0,8,0" Stroke="{Binding Colour}" StrokeThickness="1.5">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Portrait}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>
