<Window x:Class="SaveEditor.App.AdvancedToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced tools" Height="640" Width="1040" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="8">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Click="Close_Click" MinWidth="80"/>
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Text="Changes made here go into the open save like any other edit; press Save in the editor to write them."/>
        </DockPanel>

        <TabControl x:Name="Tabs" Margin="6,6,6,0" SelectionChanged="Tabs_SelectionChanged">
            <TabItem x:Name="SaveDataTab" Header="Save data">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6"
                                   Text="Every value in the save, as the game stores it (script save variables, stats, world state). Names come from the game; unnamed fields show their hash. Wrong values can break a save, so keep a backup (one is made automatically on save)."/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="DataSearchBox" Width="260" TextChanged="DataSearch_Changed"/>
                            <CheckBox x:Name="DataUnnamedBox" Content="Include unnamed fields" Margin="12,0,0,0"
                                      VerticalAlignment="Center" Checked="DataSearch_Changed" Unchecked="DataSearch_Changed"/>
                            <TextBlock x:Name="DataCountText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="DimGray"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="SaveDataGrid" Margin="0,6,0,0" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field" Binding="{Binding Path}" IsReadOnly="True" Width="3*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="Value" Width="130"
                                                Binding="{Binding Value, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" IsReadOnly="True" Width="100" Foreground="Gray"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" IsReadOnly="True" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Compare saves">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6"
                                   Text="Find where the game stores something: save in-game, make ONE change (e.g. a haircut), save again to another slot, then compare the two saves. Values that changed are listed below."/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Compare with…" Click="CompareWith_Click"/>
                            <Button Content="Swap before/after" Click="SwapCompare_Click" Margin="6,0,0,0"/>
                            <CheckBox x:Name="ShowUnnamedBox" Content="Include unnamed stats" Margin="12,0,0,0"
                                      VerticalAlignment="Center" Checked="ShowUnnamed_Changed" Unchecked="ShowUnnamed_Changed"/>
                        </StackPanel>
                        <TextBlock x:Name="CompareText" Margin="0,6" TextWrapping="Wrap" Text="Nothing compared yet."/>
                    </StackPanel>
                    <TextBlock x:Name="CompareBlocksText" DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="DimGray"/>
                    <DataGrid x:Name="CompareGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="80"/>
                            <DataGridTextColumn Header="Stat" Binding="{Binding Label}" Width="170"/>
                            <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="130"/>
                            <DataGridTextColumn Header="After" Binding="{Binding After}" Width="130"/>
                            <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="110"/>
                            <DataGridTextColumn Header="Internal name" Binding="{Binding Name}" Width="*" Foreground="Gray"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="File">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="File:" Margin="0,4"/>
                    <TextBlock x:Name="FileText" Grid.Column="1" Margin="0,4" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Row="1" Text="Game slot:" Margin="0,4"/>
                    <TextBlock x:Name="SlotText" Grid.Row="1" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2" Text="Title:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TitleBox" Grid.Row="2" Grid.Column="1" Margin="0,4" MaxLength="127"
                             TextChanged="TitleBox_TextChanged" ToolTip="The name shown in the game's Load Game menu"/>

                    <TextBlock Grid.Row="3" Text="Integrity:" Margin="0,4"/>
                    <TextBlock x:Name="IntegrityText" Grid.Row="3" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,4" FontWeight="SemiBold"
                               Text="Data blocks (decrypted body)"/>
                    <ListView x:Name="BlockList" Grid.Row="5" Grid.ColumnSpan="2">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Block" Width="120" DisplayMemberBinding="{Binding Id}"/>
                                <GridViewColumn Header="Size (bytes)" Width="140" DisplayMemberBinding="{Binding TotalSize, StringFormat=N0}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
