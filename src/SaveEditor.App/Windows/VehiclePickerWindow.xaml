<Window x:Class="SaveEditor.App.VehiclePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a vehicle" Height="760" Width="1060" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" Background="{StaticResource PageBrush}" Icon="/GtaVSaveEditor;component/Assets/app.ico">
    <Window.Resources>
        <!-- A class filter: a flat toggle that turns green when picked. -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A vehicle tile: its picture with the name under it. -->
        <Style x:Key="Tile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="2" Width="196">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A paint swatch. -->
        <Style x:Key="Swatch" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" BorderBrush="{StaticResource LineBrush}" BorderThickness="2" Padding="2">
                            <Border Width="30" Height="22" Background="{Binding Swatch}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitleText" Text="Choose a vehicle" Style="{StaticResource PageTitle}" FontSize="22"/>
            <TextBlock x:Name="WhereText" Style="{StaticResource Muted}" Margin="0,2,0,12"/>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Search" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="SearchBox" TextChanged="Search_Changed" MaxWidth="360" HorizontalAlignment="Left" Width="360"
                         ToolTip="Type part of a name, such as Adder or Zentorno"/>
            </DockPanel>
            <ItemsControl x:Name="ClassFilters">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource Chip}" GroupName="VehicleClass" Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                     Checked="Class_Checked"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- The chosen vehicle, its paint and the buttons. -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0">
            <DockPanel>
                <Image x:Name="ChosenPicture" DockPanel.Dock="Left" Height="74" Width="180" Stretch="Uniform" Margin="0,0,16,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OkButton" Content="Park here" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click"/>
                    <Button Content="Cancel" Margin="6,0,0,0" IsCancel="True"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ChosenName" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource HeadingFont}"/>
                    <TextBlock x:Name="ChosenClass" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Paint:" Style="{StaticResource Muted}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="PaintName"/>
                    </StackPanel>
                    <ListBox x:Name="Paints" ItemContainerStyle="{StaticResource Swatch}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Paint_Changed">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <ListBox x:Name="Tiles" ItemContainerStyle="{StaticResource Tile}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Tile_Changed" MouseDoubleClick="Tile_DoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Image Source="{Binding Picture}" Height="78" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding Name}" Margin="8,5,8,1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <TextBlock Text="{Binding Class}" Margin="8,0,8,6" Style="{StaticResource Muted}" FontSize="11"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoMatches" Text="No vehicle matches that search." Style="{StaticResource Muted}" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DockPanel>
</Window>
