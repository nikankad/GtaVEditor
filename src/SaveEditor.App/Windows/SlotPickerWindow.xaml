<Window x:Class="SaveEditor.App.SlotPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save to game slot" Height="480" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource PageBrush}" Icon="/GtaVSaveEditor;component/Assets/app.ico">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="19"
                   Text="Pick the slot this save should appear in under Game → Load Game. Restart GTA V afterwards; it only reads the save list at startup. If cloud saves are on, the game may replace files it doesn't know about."/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Profile folder:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="FolderBox" Width="370" SelectionChanged="FolderBox_SelectionChanged"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="WarningText" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="OkButton" Content="Save here" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" IsEnabled="False"/>
            <Button Content="Cancel" Width="90" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
        <ListBox x:Name="SlotList" SelectionChanged="SlotList_SelectionChanged" MouseDoubleClick="SlotList_DoubleClick"/>
    </DockPanel>
</Window>
