<Window x:Class="SaveEditor.App.VehicleCustomiseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mod shop" Height="780" Width="1180" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" Background="#07090A" Icon="/GtaVSaveEditor;component/Assets/app.ico"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="MenuRowBrush" Color="#C8000000"/>
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#33FFFFFF"/>

        <!-- A menu row as the game draws it: dark, turning white with black text when picked. -->
        <Style x:Key="MenuRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Row_Click"/>
            <EventSetter Event="MouseEnter" Handler="Row_MouseEnter"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource MenuRowBrush}" Padding="14,0" MinHeight="38">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0262B27"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F2F2"/>
                                <Setter Property="Foreground" Value="#0D100E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MenuRow}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="FontSize" Value="15"/>
            <Style.Resources>
                <!-- A slim scroll bar that sits quietly beside the rows. -->
                <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="MinWidth" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="{StaticResource MenuRowBrush}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#66FFFFFF" CornerRadius="3" Margin="1,0"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- An upgrade bar beside the car. -->
        <Style x:Key="StatBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="9"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#40FFFFFF"/>
                            <Border x:Name="PART_Indicator" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The car's backdrop: a dim garage glow behind the picture. -->
        <Grid.Background>
            <RadialGradientBrush Center="0.66,0.42" GradientOrigin="0.66,0.42" RadiusX="0.6" RadiusY="0.75">
                <GradientStop Color="#2A332C" Offset="0"/>
                <GradientStop Color="#121614" Offset="0.55"/>
                <GradientStop Color="#07090A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== The menu ===== -->
        <DockPanel Margin="24,24,0,16">
            <!-- Banner. -->
            <Border DockPanel.Dock="Top" Height="96" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2E7D1F" Offset="0"/>
                        <GradientStop Color="#52BE3B" Offset="0.55"/>
                        <GradientStop Color="#1F5A15" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <TextBlock Text="MOD SHOP" FontFamily="{StaticResource HeadingFont}" FontSize="52" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.RenderTransform><SkewTransform AngleX="-10"/></TextBlock.RenderTransform>
                        <TextBlock.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.6"/></TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- The heading bar: where you are in the menu. -->
            <Border DockPanel.Dock="Top" Background="Black" Padding="14,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Counter}" Foreground="{StaticResource TextBrush}" FontSize="13" VerticalAlignment="Center"/>
                    <Button x:Name="BackButton" DockPanel.Dock="Left" Content="‹ Back" Click="Back_Click" Margin="0,0,10,0" Padding="8,1"
                            Visibility="{Binding BackVisibility}"
                            ToolTip="Back to the categories (Esc or Backspace)"/>
                    <TextBlock Text="{Binding Heading}" Foreground="#5AA9E6" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                               Typography.Capitals="AllSmallCaps"/>
                </DockPanel>
            </Border>

            <!-- A note about this category or car. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource MenuRowBrush}" Padding="14,10" Margin="0,2,0,0"
                    Visibility="{Binding NoteVisibility}">
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            </Border>

            <Grid>
                <!-- The categories. -->
                <ListBox x:Name="MenuList" Style="{StaticResource MenuList}" ItemsSource="{Binding Categories}" Visibility="{Binding MenuVisibility}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="#E6000000" Padding="14,10,14,4">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold"
                                                   Typography.Capitals="AllSmallCaps"/>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Current}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Opacity="0.7" FontSize="13" VerticalAlignment="Center"
                                           MaxWidth="190" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                                <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- The options of the open category; the fitted one has a tick. -->
                <ListBox x:Name="OptionList" Style="{StaticResource MenuList}" ItemsSource="{Binding Options}" Visibility="{Binding OptionsVisibility}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="Option_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="✔" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Visibility="{Binding InstalledVisibility}" ToolTip="Fitted now"/>
                                <Border DockPanel.Dock="Left" Width="26" Height="16" Background="{Binding Swatch}" BorderBrush="#60FFFFFF" BorderThickness="1"
                                        Margin="0,0,12,0" VerticalAlignment="Center" Visibility="{Binding SwatchVisibility}"/>
                                <Image DockPanel.Dock="Left" Source="{Binding Picture}" Width="64" Height="34" Stretch="Uniform" Margin="0,3,12,3"
                                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding PictureVisibility}"/>
                                <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Plate text. -->
                <Border Background="{StaticResource MenuRowBrush}" Padding="14" VerticalAlignment="Top" Visibility="{Binding PlateVisibility}">
                    <StackPanel>
                        <TextBlock Text="Up to 8 letters, numbers or spaces." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8"/>
                        <TextBox x:Name="PlateBox" FontSize="22" FontFamily="{StaticResource HeadingFont}" CharacterCasing="Upper" MaxLength="8"
                                 Text="{Binding PlateText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding PlateError}" Foreground="#E85C5C" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- ===== The car ===== -->
        <DockPanel Grid.Column="1" Margin="32,24,28,16">
            <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Right">
                <TextBlock Text="{Binding VehicleName}" FontFamily="{StaticResource HeadingFont}" FontSize="34" Foreground="White" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding Where}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
            </StackPanel>

            <!-- Upgrade bars, top right like the game. -->
            <Border DockPanel.Dock="Top" HorizontalAlignment="Right" Width="300" Margin="0,14,0,0" Background="#A0000000" Padding="14,10"
                    Visibility="{Binding StatsVisibility}">
                <ItemsControl ItemsSource="{Binding Stats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Style="{StaticResource StatBar}" Value="{Binding Value, Mode=OneWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- A closer look at the option under the mouse: a rim, plate, livery or colour. -->
            <Border DockPanel.Dock="Bottom" HorizontalAlignment="Right" Background="#A0000000" Padding="12" Margin="0,10,0,0"
                    Visibility="{Binding PreviewVisibility}">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="180" Height="96">
                        <Border Background="{Binding PreviewSwatch}" CornerRadius="4" BorderBrush="#60FFFFFF" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewSwatch}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Image Source="{Binding PreviewPicture}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <TextBlock Text="{Binding PreviewName}" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="16,0,4,0" MaxWidth="240" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Image Source="{Binding Picture}" Stretch="Uniform" MaxWidth="820" Margin="0,10" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.7"/></Image.Effect>
            </Image>
        </DockPanel>

        <!-- ===== Hint and buttons ===== -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#E6000000" Padding="24,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Done" Style="{StaticResource PrimaryButton}" IsDefault="False" Click="Done_Click"/>
                    <Button Content="Cancel" Margin="6,0,0,0" Click="Cancel_Click" ToolTip="Puts the car back the way it was when this window opened"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                           Text="Click a category, then an option to fit it. Arrow keys and Enter work too; Esc goes back. Changes show the next time the save is loaded in game."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
