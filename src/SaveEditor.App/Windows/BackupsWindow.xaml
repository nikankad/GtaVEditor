<Window x:Class="SaveEditor.App.BackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save backups" Width="850" Height="570" MinWidth="650" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}" Icon="/Assets/app.ico">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Save backups" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Open a backup to inspect it, or restore it to a save file. Restoring makes a backup of the file being replaced."
                       Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            <TextBlock x:Name="Note" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Open backups folder" Click="Folder_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenButton" Content="Open backup" Click="Open_Click" IsEnabled="False"/>
                <Button x:Name="RestoreButton" Content="Restore…" Click="Restore_Click" IsEnabled="False" Margin="6,0" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Close" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
        <ListBox x:Name="BackupList" HorizontalContentAlignment="Stretch" SelectionChanged="Selection_Changed">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,6" ToolTip="{Binding FilePath}">
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Created, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Slot}" Margin="12,0"/></DockPanel>
                        <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
