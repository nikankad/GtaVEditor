<UserControl x:Class="SaveEditor.App.GamePickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,40">
            <TextBlock Text="Save Editor" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Pick a game to edit its saves." Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,24"/>
            <ItemsControl x:Name="GameList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Width="320" Margin="0,0,16,16" Click="Game_Click"
                                AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
