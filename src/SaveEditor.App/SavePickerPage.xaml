<UserControl x:Class="SaveEditor.App.SavePickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="48,24,48,20">
        <StackPanel DockPanel.Dock="Top">
            <Button Content="← All games" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="Back_Click"/>
            <TextBlock x:Name="GameTitle" Style="{StaticResource PageTitle}" Margin="0,10,0,0"/>
            <TextBlock Text="Pick the save you want to edit." Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"/>

            <Border x:Name="KeyBanner" Visibility="Collapsed" Background="#FFF7E0" BorderBrush="#E8C766" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,16,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Import key…" Style="{StaticResource PrimaryButton}" Click="ImportKey_Click"
                            VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="GTA V encrypts PC saves with a key that isn't included with this app. Import it once and you can open your saves."/>
                </DockPanel>
            </Border>

            <DockPanel Margin="0,20,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Browse for a save file…" Click="Browse_Click"/>
                    <Button Content="Add folder…" Margin="6,0,0,0" Click="AddFolder_Click"
                            ToolTip="Also list the saves in another folder, e.g. copies you keep elsewhere"/>
                    <Button Content="Backups" Margin="6,0,0,0" Click="Backups_Click"
                            ToolTip="Open the folder with the copies made before every save"/>
                    <Button x:Name="KeyButton" Content="Import key…" Margin="6,0,0,0" Click="ImportKey_Click"/>
                </StackPanel>
                <TextBlock x:Name="CountText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="EditButton" DockPanel.Dock="Right" Content="Edit this save" Style="{StaticResource PrimaryButton}"
                    IsEnabled="False" Click="Edit_Click"/>
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Text="Double-click a save to edit it. Nothing is changed until you press Save, and a backup is made first."/>
        </DockPanel>

        <Grid>
            <ListBox x:Name="SaveList" HorizontalContentAlignment="Stretch" BorderBrush="{StaticResource LineBrush}"
                     SelectionChanged="SaveList_SelectionChanged" MouseDoubleClick="SaveList_DoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="BorderBrush" Value="#EEF0F3"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding Path}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Slot}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="{Binding Title}" FontSize="14"/>
                                <TextBlock Text="{Binding Folder}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding When}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit" Click="Edit_Click"/>
                        <MenuItem Header="Show in folder" Click="ShowInFolder_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Style="{StaticResource Muted}" FontSize="14" MaxWidth="420"
                       Text="No saves found. Save in-game first, or use 'Browse for a save file…' or 'Add folder…' to point at your saves."/>
        </Grid>
    </DockPanel>
</UserControl>
